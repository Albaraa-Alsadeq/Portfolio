# Copy this file to .env and fill in your values
# cp .env.example .env

# Django
SECRET_KEY=your-very-long-random-secret-key-here
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Supabase PostgreSQL
# Get this from: Supabase Dashboard > Project Settings > Database > Connection string > URI
# Change [YOUR-PASSWORD] to your actual password
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# Cloudinary (for image/file storage)
# Get from: cloudinary.com > Dashboard
CLOUD_NAME=your-cloudinary-cloud-name
API_KEY=your-cloudinary-api-key
API_SECRET=your-cloudinary-api-secret

# Email (Gmail)
# Use App Password: Google Account > Security > 2-Step > App passwords
EMAIL_HOST_USER=your@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
